# =====================================================================
# Proprietary NewsGuard data -- licensed to the authors, NOT redistributable.
# Also far too large for GitHub (single files up to 127 MB; limit is 100 MB).
# Code/Pipeline and Code/Attempts keep all their data in Dataset/ at the repo root (only Dataset/LEGGIMI.md is tracked);
# IrForGood and RejectedTCSS keep their own Code/<version>/Dataset/. This pattern matches them all.
# =====================================================================
**/Dataset/*
!/Dataset/LEGGIMI.md

# Secrets
key.txt
**/key.txt
*.env
.env
UTILI.md

# =====================================================================
# Large derived files (regenerable; 70-92 MB each, over GitHub's 100 MB limit)
# =====================================================================
Code/IrForGood/Results/_archive/errors/
Code/IrForGood/Results/_archive/fullanalysis/
Code/IrForGood/Results/predictions/finetuned/mistral/24B_results_enriched_checkpoint.csv

# Derived predictions: regenerable by analysis/paper_results.ipynb (14 MB)
Code/IrForGood/Results/derived/predictions_long.csv

# =====================================================================
# Jupyter
# =====================================================================
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# =====================================================================
# LaTeX build artifacts (the compiled main.pdf IS tracked on purpose)
# =====================================================================
*.aux
*.bbl
*.blg
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
Paper/**/*.log

# =====================================================================
# Python / OS
# =====================================================================
__pycache__/
*.pyc
.DS_Store
Thumbs.db


# Web Science 2027: cache grandi e rigenerabili dei risultati (embedding, coefficienti) e test di fattibilità.
# Restano in locale e nel backup ~/Backup/artes4_John_WebScience2027, non su GitHub (file oltre i 100 MB).
Code/WebScience2027/**/Results/**/*.npy
Code/WebScience2027/**/Results/**/*.pkl
Code/WebScience2027/Tentativi/*/Results/prove/
Code/WebScience2027/**/Results/**/prova/

# =====================================================================
# Modelli addestrati (dal tentativo 13): TF-IDF e ModernBERT per fold e finali, circa 3,5 GB;
# si scaricano dal server con lo script del tentativo e restano solo in locale
# =====================================================================
Code/Attempts/Tentativi/*/Modelli/
# tentativi 14-15: dataset con etichette NewsGuard e previsioni per articolo (dati riservati, restano fuori da git)
Code/WebScience2027/Tentativi/*/Results/dataset/*.csv*
Code/WebScience2027/Tentativi/*/Results/cache/
Code/WebScience2027/Tentativi/*/Results/dataset/cache/
# tentativo 16: previsioni di ModernBERT per articolo (servono alla sezione 3 di 06_confronto; si scaricano con scarica.sh)
Code/WebScience2027/Tentativi/16_DataPreparation/Results/modernbert/*/fold*.csv
# tentativo 16: previsioni per testata con il punteggio NewsGuard vero (dati NewsGuard, restano fuori da git)
Code/WebScience2027/Tentativi/16_DataPreparation/Results/**/previsioni_testate.csv
Code/WebScience2027/Tentativi/16_DataPreparation/Results/analisi_embedding/*_previsioni.csv
Code/WebScience2027/Tentativi/16_DataPreparation/Results/analisi_embedding/media_testate_*

# Modelli addestrati di tutti i tentativi (radice del repo), fuori da git
/Modelli/
# archivio leggero dei dati (si crea con Code/WebScience2027/crea_archivio_dataset.py), fuori da git
/Dataset.zip
# tentativo 18: previsioni per articolo e per testata (pesanti, fuori da git; restano sul PC e sul server)
Code/WebScience2027/Tentativi/18_PunteggioEsatto/Results/**/*.csv.gz
Code/WebScience2027/Tentativi/18_PunteggioEsatto/Results/**/fold*.csv
Code/WebScience2027/Tentativi/18_PunteggioEsatto/Results/lineari/lavori/
Code/WebScience2027/Tentativi/18_PunteggioEsatto/Results/cpu_fatto

